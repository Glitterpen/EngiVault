# Web (safe public values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Public Cloudflare Turnstile widget key. Supabase stores the matching secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
RESEND_API_KEY=
INVITATION_FROM_EMAIL=EngiCite <invitations@your-verified-domain.com>
NOTIFICATION_FROM_EMAIL=EngiCite <notifications@your-verified-domain.com>
CRON_SECRET=replace-with-a-random-string-at-least-16-characters-long

# Server-only; never prefix with NEXT_PUBLIC_
ENVIRONMENT=development
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_URL=https://your-project.supabase.co
OPENAI_API_KEY=server-only-openai-key
PROCESSOR_SHARED_SECRET=replace-with-a-long-random-value
MALWARE_SCAN_MODE=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=120

# Organisation subscriptions (Paystack only).
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE=
PAYSTACK_PLAN_AMOUNT_SUBUNIT=
PAYSTACK_CURRENCY=NGN
PAYSTACK_ENGICITE_PLAN_CODE=team

# Qualified organisation seal for generated client transmittals.
# Keep disabled until Adobe PDF Services and an Intesi Group qualified e-seal
# credential have both been verified. All values below are server-only.
ELECTRONIC_SEAL_MODE=disabled
ELECTRONIC_SEAL_ASSURANCE=unverified
ADOBE_PDF_SERVICES_CLIENT_ID=
ADOBE_PDF_SERVICES_CLIENT_SECRET=
ADOBE_PDF_SERVICES_BASE_URL=https://pdf-services.adobe.io
INTESI_CSC_TOKEN_URL=
INTESI_CSC_CLIENT_ID=
INTESI_CSC_CLIENT_SECRET=
INTESI_CSC_CREDENTIAL_ID=
INTESI_CSC_PIN=
INTESI_ADOBE_PROVIDER_NAME=
QUALIFIED_TSA_URL=
QUALIFIED_TSA_USERNAME=
QUALIFIED_TSA_PASSWORD=
